# Copy to .env for local development. .env is gitignored -- never commit
# real secrets. On Vercel, set these in Project Settings -> Environment
# Variables instead.

# Postgres connection string (Neon, via the Vercel Marketplace). For quick
# local runs you can use SQLite: DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=

# Encrypts each user's Plaid secret and bank access tokens before they're
# stored. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_KEY=

# Signs the login session cookie. Any long random string:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# There are deliberately no Plaid keys here: each user enters their own
# Plaid Sandbox keys during onboarding.
